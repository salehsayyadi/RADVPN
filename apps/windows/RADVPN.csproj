<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion><FileVersion>2.0.0.0</FileVersion><Product>RADVPN</Product>
    <ApplicationIcon>../../assets/RADVPN.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest><StartupObject>RADVPN.Program</StartupObject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" /></ItemGroup>
  <ItemGroup><Content Include="../../packages/localization/*.json" Link="localization/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup><Content Include="../../assets/RADVPN.ico" Link="RADVPN.ico" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
